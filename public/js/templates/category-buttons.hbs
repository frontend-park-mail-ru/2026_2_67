{{#each categories}}
  <button class="site-header__category" type="button" data-category="{{category}}">
    {{#if pictureUrl}}
      <span class="site-header__category-icon"><img src="{{pictureUrl}}" alt="" /></span>
    {{/if}}
    <span>{{category}}</span>
    <span class="site-header__category-arrow" aria-hidden="true">&gt;</span>
  </button>
{{else}}
  <p class="site-header__category-empty">Категорий пока нет.</p>
{{/each}}
