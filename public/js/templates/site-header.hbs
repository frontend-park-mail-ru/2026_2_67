<header class="site-header">
  <div class="site-header__inner">
    <a class="brand site-header__logo" href="/" data-page="catalog" aria-label="VIBE — каталог">
      <span class="brand__wordmark">VIBE</span>
    </a>
    <div class="site-header__controls">
      <button class="site-header__action site-header__section" type="button" data-catalog-toggle aria-controls="catalog-menu" aria-expanded="false">Каталог</button>
      <form class="site-header__search" role="search" data-catalog-search>
        <label class="visually-hidden" for="catalog-search">Поиск товаров</label>
        <span class="site-header__search-ring" aria-hidden="true"></span>
        <span class="site-header__search-handle" aria-hidden="true"></span>
        <input id="catalog-search" type="search" name="query" placeholder="Поиск товаров" autocomplete="off" />
      </form>
    </div>
    <nav class="site-header__nav" aria-label="Действия и аккаунт">
      <button class="site-header__icon site-header__icon--cart" type="button" aria-label="Корзина" aria-expanded="false"><span class="site-header__icon-image"><img src="/images/cart-icon.png" alt="" /></span><span class="site-header__icon-label">Корзина</span></button>
      <span class="site-header__icon site-header__icon--inactive"><span class="site-header__icon-image"><img src="/images/notifications-icon.png" alt="" /></span><span class="site-header__icon-label">Уведомления</span></span>
      {{#if user}}
      <div class="site-header__profile-wrap">
        <a class="site-header__icon site-header__icon--link site-header__icon--logged-in" href="/profile" data-page="profile" aria-label="Личный профиль"{{#if isProfile}} aria-current="page"{{/if}}><span class="site-header__icon-image"><img src="/images/account-icon.png" alt="" /></span><span class="site-header__icon-label">Профиль</span></a>
        <button class="site-header__action site-header__action--logout" type="button" data-action="logout">Выйти</button>
      </div>
      {{else}}
      <a class="site-header__icon site-header__icon--link" href="/login" data-page="login" aria-label="Войти в аккаунт"><span class="site-header__icon-image"><img src="/images/account-icon.png" alt="" /></span><span class="site-header__icon-label">Войти</span></a>
      {{/if}}
    </nav>
  </div>
  <div class="site-header__cart-panel" id="cart-panel" hidden></div>
  <div class="site-header__catalog-menu" id="catalog-menu" hidden>
    <h2 class="site-header__catalog-title">Все категории</h2>
    <div class="site-header__categories">
      <button class="site-header__category" type="button" data-category="Одежда"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/t_shirt.png" alt="" /></span><span>Одежда</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Электроника"><span class="site-header__category-icon site-header__category-icon--extra-padded"><img src="/images/categories/headphones.png" alt="" /></span><span>Электроника</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Авто"><span class="site-header__category-icon"><img src="/images/categories/auto.png" alt="" /></span><span>Авто</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Спорт"><span class="site-header__category-icon"><img src="/images/categories/sport.png" alt="" /></span><span>Спорт</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Игрушки"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/toys.png" alt="" /></span><span>Игрушки</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Зоотовары"><span class="site-header__category-icon"><img src="/images/categories/pet_supplies.png" alt="" /></span><span>Зоотовары</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Хобби"><span class="site-header__category-icon"><img src="/images/categories/hobby.png" alt="" /></span><span>Хобби</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Декор"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/decor.png" alt="" /></span><span>Декор</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
      <button class="site-header__category" type="button" data-category="Парфюмерия"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/perfumery.png" alt="" /></span><span>Парфюмерия</span><span class="site-header__category-arrow" aria-hidden="true">&gt;</span></button>
    </div>
  </div>
</header>
<div class="site-header__category-strip">
  <button class="site-header__strip-category" type="button" data-category="Одежда"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/t_shirt.png" alt="" /></span>Одежда</button>
  <button class="site-header__strip-category" type="button" data-category="Электроника"><span class="site-header__category-icon site-header__category-icon--extra-padded"><img src="/images/categories/headphones.png" alt="" /></span>Электроника</button>
  <button class="site-header__strip-category" type="button" data-category="Авто"><span class="site-header__category-icon"><img src="/images/categories/auto.png" alt="" /></span>Авто</button>
  <button class="site-header__strip-category" type="button" data-category="Спорт"><span class="site-header__category-icon"><img src="/images/categories/sport.png" alt="" /></span>Спорт</button>
  <button class="site-header__strip-category" type="button" data-category="Игрушки"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/toys.png" alt="" /></span>Игрушки</button>
  <button class="site-header__strip-category" type="button" data-category="Зоотовары"><span class="site-header__category-icon"><img src="/images/categories/pet_supplies.png" alt="" /></span>Зоотовары</button>
  <button class="site-header__strip-category" type="button" data-category="Хобби"><span class="site-header__category-icon"><img src="/images/categories/hobby.png" alt="" /></span>Хобби</button>
  <button class="site-header__strip-category" type="button" data-category="Декор"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/decor.png" alt="" /></span>Декор</button>
  <button class="site-header__strip-category" type="button" data-category="Парфюмерия"><span class="site-header__category-icon site-header__category-icon--padded"><img src="/images/categories/perfumery.png" alt="" /></span>Парфюмерия</button>
</div>
