<article class="product-card" data-product-card data-product-id="{{id}}">
  <div class="product-card__image-wrap">
    {{#if discountPercent}}<span class="product-card__discount">-{{discountPercent}}%</span>{{/if}}
    <a class="product-card__image-link" href="{{productUrl id title}}" data-product-link aria-label="Открыть товар {{title}}"><img class="product-card__image" data-product-image src="{{currentImage}}" alt="{{title}}" /></a>
    {{#if hasMultipleImages}}
      <button class="product-card__arrow product-card__arrow--prev" type="button" data-image-prev aria-label="Предыдущая фотография">&lt;</button>
      <button class="product-card__arrow product-card__arrow--next" type="button" data-image-next aria-label="Следующая фотография">&gt;</button>
      <div class="product-card__dots" aria-label="Фотографии товара">
        {{#each dots}}
          <button class="product-card__dot {{#if isActive}}product-card__dot--active{{/if}}" type="button" data-image-dot="{{index}}" aria-label="Показать фотографию {{index}}"></button>
        {{/each}}
      </div>
    {{/if}}
  </div>
  <p class="product-card__price"><span>{{price}}</span>{{#if oldPrice}}<del class="product-card__old-price">{{oldPrice}}</del>{{/if}}</p>
  <h2 class="product-card__title{{#if sellerName}} product-card__title--with-seller{{/if}}"><a href="{{productUrl id title}}" data-product-link>{{title}}</a></h2>
  {{#if sellerName}}<p class="product-card__seller">Продавец: {{sellerName}}</p>{{/if}}
  <p class="product-card__reviews">
    <span class="product-card__rating" aria-label="Рейтинг {{rating}} из 5"><span class="product-card__star" aria-hidden="true">★</span> {{rating}}</span>
    <span class="product-card__reviews-count">{{reviewsText}}</span>
  </p>
  {{#if showAddToCartButton}}
    <div class="product-card__cart-actions" data-cart-controls>
      {{> productCartControls}}
    </div>
  {{/if}}
</article>
