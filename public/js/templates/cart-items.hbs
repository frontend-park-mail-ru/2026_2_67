{{#if errorMessage}}
  <p class="cart-message" role="alert">{{errorMessage}}</p>
{{/if}}
{{#if updating}}
  <p class="cart-message visually-hidden" role="status">Обновляем корзину…</p>
{{/if}}
{{#if loading}}
  <p class="cart-message" role="status">Загрузка корзины…</p>
{{else}}
{{#if items}}
  <ul class="cart-list"{{#if updating}} aria-busy="true"{{/if}}>
    {{#each items}}
      <li class="cart-item" data-cart-item-id="{{id}}">
        <img class="cart-item__image" src="{{image}}" alt="" />
        <div class="cart-item__details">
          <p class="cart-item__title">{{title}}</p>
          <p class="cart-item__price">{{price}}</p>
          {{#if ../readonly}}
            <p class="cart-item__count">Количество: {{quantity}}</p>
            {{#if stockWarning}}<p class="cart-item__stock-warning" role="alert">{{stockWarning}}</p>{{/if}}
            {{#if previewError}}<p class="cart-item__stock-warning" role="alert">{{previewError}}</p>{{/if}}
          {{else}}
            <div class="cart-item__actions">
              <div class="cart-item__quantity-control">
                <button class="cart-item__decrease" type="button" aria-label="Уменьшить количество товара {{title}}"{{#unless ../canUseCart}} disabled{{/unless}}>−</button>
                <span class="cart-item__quantity">{{quantity}}</span>
                <button class="cart-item__increase" type="button" aria-label="Увеличить количество товара {{title}}"{{#if increaseDisabled}} disabled{{else}}{{#unless ../canUseCart}} disabled{{/unless}}{{/if}}>+</button>
              </div>
              <button class="cart-item__remove" type="button" aria-label="Удалить товар {{title}} из корзины"{{#unless ../canUseCart}} disabled{{/unless}}>Удалить</button>
              {{#if stockWarning}}<span class="cart-item__stock-warning" role="status">{{stockWarning}}</span>{{/if}}
            </div>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ul>
{{else}}
  {{#unless errorMessage}}
    <p class="cart-empty">Корзина пуста</p>
  {{/unless}}
{{/if}}
{{/if}}
