<main class="page auth-page">
  <a class="auth-page__back" href="#" data-page="catalog">← В каталог</a>
  <section class="auth-card" aria-labelledby="login-title">
    <a class="brand auth-card__brand" href="#" data-page="catalog" aria-label="VibeMarket — каталог"><span>Vibe</span>Market</a>
    <h1 id="login-title">Войдите в аккаунт</h1>
    <form data-auth-form="login" novalidate>
      <div class="form-field">
        <label class="visually-hidden" for="login-identity">Почта или логин</label>
        <input id="login-identity" type="text" name="loginOrEmail" placeholder="Почта / логин" autocomplete="username" aria-describedby="login-identity-error" />
        <p id="login-identity-error" class="field-error" data-error-for="loginOrEmail"></p>
      </div>
      <div class="form-field">
        <label class="visually-hidden" for="login-password">Пароль</label>
        <input id="login-password" type="password" name="password" placeholder="Пароль" autocomplete="current-password" aria-describedby="login-password-error" />
        <p id="login-password-error" class="field-error" data-error-for="password"></p>
      </div>
      <button class="auth-card__submit" type="submit">Войти</button>
    </form>
    <p class="form-message" data-form-message role="status"></p>
    <p class="auth-card__switch">Нет аккаунта? <a href="#" data-page="signup">Зарегистрироваться</a></p>
  </section>
</main>
