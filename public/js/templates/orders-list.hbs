{{#if orders}}
  <p class="orders-page__count">Всего заказов: {{orderCount}} · Сначала новые</p>
{{/if}}
{{#each orders}}
  <article class="orders-page__order" aria-labelledby="order-{{id}}">
    <header class="orders-page__heading">
      <div>
        <h2 id="order-{{id}}">Заказ №{{number}}</h2>
        <p class="orders-page__date">Оформлен <time datetime="{{createdAt}}">{{createdDate}}</time></p>
      </div>
      <span class="orders-page__status">{{status}}</span>
    </header>

    <div class="orders-page__summary">
      <div><span class="orders-page__muted">Количество товаров</span><strong>{{totalCount}} шт.</strong></div>
      <div><span class="orders-page__muted">Итого с учётом скидок</span><strong class="orders-page__total">{{formattedTotal}}</strong></div>
    </div>

    <section class="orders-page__section" aria-label="Состав заказа">
      <h3>Товары в заказе</h3>
      <ul class="orders-page__products">
        {{#each products}}
          <li class="orders-page__product">
            <a class="orders-page__pictures" href="{{productUrl productId name}}" data-product-link aria-label="Открыть товар {{name}}">
              {{#each pictures}}
                <img src="{{this}}" alt="{{../name}}" loading="lazy" width="80" height="96" />
              {{else}}
                <span class="orders-page__no-image">Нет фото</span>
              {{/each}}
            </a>
            <div class="orders-page__product-info">
              <h4><a href="{{productUrl productId name}}" data-product-link>{{name}}</a></h4>
              <p class="orders-page__muted">{{category}} · Продавец: {{sellerName}}</p>
              {{#if sellerAvatar}}<img class="orders-page__seller-avatar" src="{{sellerAvatar}}" alt="Аватар продавца {{sellerName}}" loading="lazy" width="32" height="32" />{{/if}}
              {{#if description}}
                <details class="orders-page__description">
                  <summary>Описание товара</summary>
                  <p>{{description}}</p>
                </details>
              {{/if}}
              <p>{{count}} шт. × {{formattedUnitPrice}}</p>
              <strong>{{formattedTotal}}</strong>
            </div>
          </li>
        {{else}}
          <li class="orders-page__muted">В заказе нет товаров.</li>
        {{/each}}
      </ul>
    </section>

    <div class="orders-page__delivery-grid">
      <section class="orders-page__section" aria-label="Пункт выдачи заказа">
        <h3>Получение заказа</h3>
        <p><strong>Пункт выдачи №{{pickupPoint.id}}</strong></p>
        <p>Время работы: {{pickupPoint.workingHours}}</p>
        <p class="orders-page__muted">Координаты: {{pickupPoint.latitude}}, {{pickupPoint.longitude}}</p>
      </section>
      <section class="orders-page__section" aria-label="Промокод заказа">
        <h3>Промокод</h3>
        {{#if promocode}}
          <p><strong>{{promocode}}</strong></p>
        {{else}}
          <p class="orders-page__muted">Не использовался</p>
        {{/if}}
      </section>
    </div>

    <details class="orders-page__details">
      <summary>Дополнительная информация о заказе</summary>
      <p>Идентификатор заказа: {{id}}</p>
    </details>
  </article>
{{else}}
  <div class="orders-page__empty">
    <h2>Здесь будут ваши заказы</h2>
    <p>Вы ещё не оформили ни одного заказа. Самое время найти что-нибудь для себя.</p>
    <a class="orders-page__catalog-link" href="/" data-page="home">Перейти в каталог</a>
  </div>
{{/each}}
