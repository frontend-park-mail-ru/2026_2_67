<div class="page auth-page">
  <main class="auth-page__content">
    <section class="auth-card" aria-labelledby="signup-title">
      <a class="brand auth-card__brand" href="#" data-page="catalog" aria-label="VibeMarket — каталог">
        <img class="brand__mark" src="/images/vibemarket-logo.png" alt="" />
        <span class="brand__name"><span>Vibe</span>Market</span>
      </a>
      <h1 id="signup-title">Создайте аккаунт</h1>
      <form data-auth-form="signup" novalidate>
        <div class="form-field">
          <label class="visually-hidden" for="signup-login">Логин</label>
          <input id="signup-login" type="text" name="login" placeholder="Логин" autocomplete="username" aria-describedby="signup-login-error" />
          <p id="signup-login-error" class="field-error" data-error-for="login"></p>
        </div>
        <div class="form-field">
          <label class="visually-hidden" for="signup-email">Почта</label>
          <input id="signup-email" type="email" name="email" placeholder="Почта" autocomplete="email" aria-describedby="signup-email-error" />
          <p id="signup-email-error" class="field-error" data-error-for="email"></p>
        </div>
        <div class="form-field">
          <label class="visually-hidden" for="signup-password">Пароль</label>
          <input id="signup-password" type="password" name="password" placeholder="Пароль" autocomplete="new-password" aria-describedby="signup-password-error" />
          <p id="signup-password-error" class="field-error" data-error-for="password"></p>
        </div>
        <div class="form-field">
          <label class="visually-hidden" for="signup-repeat">Повторите пароль</label>
          <input id="signup-repeat" type="password" name="passwordRepeat" placeholder="Повторите пароль" autocomplete="new-password" aria-describedby="signup-repeat-error" />
          <p id="signup-repeat-error" class="field-error" data-error-for="passwordRepeat"></p>
        </div>
        <p class="form-message" data-form-message role="status"></p>
        <button class="auth-card__submit" type="submit">Зарегистрироваться</button>
      </form>
      <p class="auth-card__switch">Уже есть аккаунт? <a href="#" data-page="login">Войти</a></p>
    </section>
  </main>
  {{> siteFooter}}
</div>
