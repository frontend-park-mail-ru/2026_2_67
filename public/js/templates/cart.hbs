<div class="cart-header">
  <h2 class="cart-header__title">Корзина <span class="cart-header__count">{{itemCountText}}</span></h2>
  <button class="cart-header__close" type="button" aria-label="Закрыть корзину">×</button>
</div>
{{> cartItems}}
<div class="cart-footer">
  <div class="cart-total">
    <span>Итого</span>
    <strong class="cart-total__price">{{totalPrice}}</strong>
  </div>
</div>
