<div class="page catalog-page">
  {{> siteHeader}}
  <main class="catalog-page__content">
    <div class="catalog-page__content-inner">
      <h1>{{heading}}</h1>
      <div class="catalog-page__grid">{{{productsHtml}}}</div>
      <div class="catalog-page__load-more-wrap" hidden>
        <button class="catalog-page__load-more" type="button">Показать ещё</button>
      </div>
    </div>
  </main>
  {{> siteFooter}}
</div>
