<div class="page catalog-page">
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand site-header__logo" href="#" data-page="catalog" aria-label="VibeMarket — каталог">
        <img class="brand__mark" src="/images/vibemarket-logo.png" alt="" />
        <span class="brand__name"><span>Vibe</span>Market</span>
      </a>
      <nav class="site-header__nav" aria-label="Основная навигация">
        {{#if user}}
        <div class="site-header__profile-wrap">
          <span class="site-header__profile"><strong>{{user.name}}</strong><span>{{user.email}}</span></span>
          <button class="site-header__action site-header__action--logout" type="button" data-action="logout">Выйти</button>
        </div>
        {{else}}
        <a class="site-header__action" href="#" data-page="login">Войти</a>
        <a class="site-header__action" href="#" data-page="signup">Регистрация</a>
        {{/if}}
      </nav>
    </div>
  </header>
  <main class="catalog-page__content">
    <div class="catalog-page__content-inner">
      <h1>Каталог товаров</h1>
      <div class="catalog-page__grid">{{{productsHtml}}}</div>
    </div>
  </main>
  {{> siteFooter}}
</div>
